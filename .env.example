VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=

# Pexels/Pixabay keys are no longer client-side (VITE_-prefixed vars are
# inlined into the public JS bundle). Set them as Supabase secrets instead,
# read only by supabase/functions/resolve-destination-photo:
#   supabase secrets set PEXELS_API_KEY=... PIXABAY_API_KEY=...
